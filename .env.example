KNOWLEDGE_COMPILER_PROVIDER=mock
LLM_BASE_URL=https://api.example.com/v1
LLM_API_KEY=
LLM_MODEL=
# Optional: overrides the default text-embedding-v3 used for KeyBERT-style keyphrase extraction
LLM_EMBEDDING_MODEL=text-embedding-v3
# 知乎 OAuth（黑客松作品接入本人账号用）。三项都必须与活动页面登记值一致，
# 尤其 ZHIHU_OAUTH_REDIRECT_URI 要逐字符相同，包括协议、域名、路径和尾部斜杠。
# app_id / app_key 由活动页面在创建项目后分配，不是 CLI 用的 Access Secret。
# 真实值只写进 .env.local（已被 gitignore），不要提交、不要贴进 issue 或截图。
ZHIHU_OAUTH_APP_ID=
ZHIHU_OAUTH_APP_KEY=
ZHIHU_OAUTH_REDIRECT_URI=
# 开放平台 Access Secret：鉴权调用方本人。代表 OAuth 用户读数据时，
# 请求同时带 Authorization: Bearer <这个值> 和 X-OAuth-Token: <用户 token>。
ZHIHU_ACCESS_SECRET=
