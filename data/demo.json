  "concepts": [
    {"id":"c01","name":"大语言模型","slug":"large-language-model","summary":"通过大规模语料进行预训练、能够理解与生成自然语言的概率模型，也是本知识花园的总入口。","domain":"模型基础","level":"foundation"},
    {"id":"c02","name":"Transformer","slug":"transformer","summary":"以自注意力和前馈网络为核心的序列建模架构，为现代大语言模型提供了可并行扩展的骨架。","domain":"模型基础","level":"foundation","parentId":"c01"},
    {"id":"c03","name":"Attention","slug":"attention","summary":"根据查询与键的匹配程度，对值进行动态加权聚合，使模型能选择性地使用上下文信息。","domain":"注意力机制","level":"foundation","parentId":"c02"},
    {"id":"c04","name":"位置编码","slug":"position-encoding","summary":"向不具备天然顺序感知能力的注意力机制注入 token 的位置与相对距离信息。","domain":"注意力机制","level":"foundation","parentId":"c02"},
    {"id":"c05","name":"RoPE","slug":"rope","summary":"通过旋转变换把绝对位置编码进查询和键，并让注意力分数自然携带相对位置信息。","domain":"注意力机制","level":"intermediate","parentId":"c04"},
    {"id":"c06","name":"KV Cache","slug":"kv-cache","summary":"在自回归生成中复用历史 token 的 Key 与 Value，避免每一步重复计算完整上下文。","domain":"推理系统","level":"intermediate","parentId":"c09"},
    {"id":"c07","name":"FlashAttention","slug":"flash-attention","summary":"通过分块与 IO 感知计算减少显存读写，在保持精确注意力结果的同时显著提升速度。","domain":"注意力机制","level":"advanced","parentId":"c03"},
    {"id":"c08","name":"连续批处理","slug":"continuous-batching","summary":"请求完成后立即补入新请求，让 GPU 批次持续工作，是高吞吐推理服务的关键调度策略。","domain":"推理系统","level":"intermediate","parentId":"c09"},
    {"id":"c09","name":"推理服务","slug":"inference-serving","summary":"把模型推理组织成稳定服务，核心约束包括吞吐、首 token 延迟、显存与调度公平性。","domain":"推理系统","level":"foundation","parentId":"c01"},
    {"id":"c10","name":"PagedAttention","slug":"paged-attention","summary":"借鉴虚拟内存分页管理 KV Cache，减少碎片并支持请求间安全共享缓存块。","domain":"推理系统","level":"advanced","parentId":"c06"},
    {"id":"c11","name":"vLLM","slug":"vllm","summary":"面向高吞吐大模型服务的推理引擎，以 PagedAttention 和连续批处理为核心能力。","domain":"推理系统","level":"advanced","parentId":"c09"},
    {"id":"c12","name":"长上下文","slug":"long-context","summary":"让模型在更长序列中可靠利用信息的能力，涉及位置外推、计算复杂度、显存和评测。","domain":"长上下文","level":"intermediate","parentId":"c01"},
    {"id":"c13","name":"上下文窗口","slug":"context-window","summary":"单次推理可接收与生成的 token 总预算；窗口更长不等于模型能同等有效地使用全部信息。","domain":"长上下文","level":"foundation","parentId":"c12"},
    {"id":"c14","name":"量化","slug":"quantization","summary":"用更低精度表示权重或激活，以换取更低显存占用和更高推理吞吐。","domain":"推理系统","level":"intermediate","parentId":"c09"},
    {"id":"c15","name":"上下文检索","slug":"context-retrieval","summary":"从外部知识中筛选与问题相关的片段，在有限上下文预算内提升信息密度。","domain":"长上下文","level":"intermediate","parentId":"c12"}
  ],
