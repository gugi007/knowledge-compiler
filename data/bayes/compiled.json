  "articles": [
    {
      "id": "a01",
      "title": "样本空间：概率的地基",
      "slug": "sample-space",
      "summary": "概率论的第一件事，是把随机试验所有可能的结果写成一个集合，这就是样本空间 $\\Omega$。",
      "publishedAt": "2022-03-12",
      "readingTimeMinutes": 1,
      "sourceUrl": "https://example.com/bayes-lab/sample-space"
    },
    {
      "id": "a02",
      "title": "条件概率：信息如何改变判断",
      "slug": "conditional-probability",
      "summary": "条件概率 $P(A\\mid B)$ 回答的是：当已知 $B$ 发生，$A$ 的可能性该如何重估，它的定义是 $P(A\\mid B)=\\frac{P(A\\cap B)}{P(B)}$。",
      "publishedAt": "2022-05-08",
      "readingTimeMinutes": 1,
      "sourceUrl": "https://example.com/bayes-lab/conditional-probability"
    },
    {
      "id": "a03",
      "title": "独立性：当条件不再改变概率",
      "slug": "independence",
      "summary": "如果知道 $B$ 是否发生，都不会改变 $A$ 的概率，我们就说 $A$ 与 $B$ 独立，记作 $P(A\\mid B)=P(A)$。",
      "publishedAt": "2022-06-26",
      "readingTimeMinutes": 1,
      "sourceUrl": "https://example.com/bayes-lab/independence"
    },
    {
      "id": "a04",
      "title": "贝叶斯定理：从结果反推原因",
      "slug": "bayes-theorem",
      "summary": "贝叶斯定理把 $P(A\\mid B)$ 与 $P(B\\mid A)$ 联系起来：$P(A\\mid B)=\\frac{P(B\\mid A)P(A)}{P(B)}$。",
      "publishedAt": "2022-08-30",
      "readingTimeMinutes": 1,
      "sourceUrl": "https://example.com/bayes-lab/bayes-theorem"
    },
    {
      "id": "a05",
      "title": "随机变量：把结果映射成数",
      "slug": "random-variable",
      "summary": "随机变量 $X$ 是一个从样本空间到实数的函数，它把语言描述的结果翻译成可以计算的数。",
      "publishedAt": "2022-11-13",
      "readingTimeMinutes": 1,
      "sourceUrl": "https://example.com/bayes-lab/random-variable"
    },
    {
      "id": "a06",
      "title": "期望：概率加权的平均值",
      "slug": "expectation",
      "summary": "期望是随机变量取值的概率加权平均：$\\mathbb{E}[X]=\\sum_x x\\,p(x)$，连续情形则写成积分 $\\int x f(x)\\,dx$。",
      "publishedAt": "2023-01-07",
      "readingTimeMinutes": 1,
      "sourceUrl": "https://example.com/bayes-lab/expectation"
    },
    {
      "id": "a07",
      "title": "方差：不确定性的度量",
      "slug": "variance",
      "summary": "方差刻画随机变量偏离期望的程度：$\\operatorname{Var}(X)=\\mathbb{E}[(X-\\mathbb{E}[X])^2]$，它的平方根是标准差，与原变量同量纲。",
      "publishedAt": "2023-03-19",
      "readingTimeMinutes": 1,
      "sourceUrl": "https://example.com/bayes-lab/variance"
    },
    {
      "id": "a08",
      "title": "常见分布：从伯努利到正态",
      "slug": "common-distributions",
      "summary": "常见分布是概率论留给统计推断的工具箱，它们把随机变量的取值规律压缩成少数几个参数。",
      "publishedAt": "2023-05-28",
      "readingTimeMinutes": 1,
      "sourceUrl": "https://example.com/bayes-lab/common-distributions"
    },
    {
      "id": "a09",
      "title": "联合分布：两个变量一起看",
      "slug": "joint-distribution",
      "summary": "联合分布描述多个随机变量同时取值的方式：$F(x,y)=P(X\\le x,\\,Y\\le y)$。",
      "publishedAt": "2023-08-06",
      "readingTimeMinutes": 1,
      "sourceUrl": "https://example.com/bayes-lab/joint-distribution"
    },
    {
      "id": "a10",
      "title": "协方差与相关：变量之间的联动",
      "slug": "covariance-and-correlation",
      "summary": "协方差定义为 $\\operatorname{Cov}(X,Y)=\\mathbb{E}[(X-\\mathbb{E}[X])(Y-\\mathbb{E}[Y])]$，它衡量两个变量是否同向偏离各自的期望。",
      "publishedAt": "2023-10-22",
      "readingTimeMinutes": 1,
      "sourceUrl": "https://example.com/bayes-lab/covariance-and-correlation"
    },
    {
      "id": "a11",
      "title": "大数定律：频率为什么稳定",
      "slug": "law-of-large-numbers",
      "summary": "大数定律说明，当样本量 $n$ 增大时，样本均值 $\\bar{X}_n=\\frac{1}{n}\\sum_{i=1}^n X_i$ 会依概率收敛到总体期望 $\\mu$。",
      "publishedAt": "2023-12-30",
      "readingTimeMinutes": 1,
      "sourceUrl": "https://example.com/bayes-lab/law-of-large-numbers"
    },
    {
      "id": "a12",
      "title": "中心极限定理：正态性的来源",
      "slug": "central-limit-theorem",
      "summary": "中心极限定理指出，大量独立同分布随机变量之和经过标准化后趋近标准正态分布：$\\frac{\\bar{X}_n-\\mu}{\\sigma/\\sqrt{n}}\\Rightarrow N(0,1)$。",
      "publishedAt": "2024-03-16",
      "readingTimeMinutes": 1,
      "sourceUrl": "https://example.com/bayes-lab/central-limit-theorem"
    },
    {
      "id": "a13",
      "title": "似然函数：数据反过来评价参数",
      "slug": "likelihood-function",
      "summary": "似然函数把观测数据的联合概率看成参数的函数：$L(\\theta;x)=P(x\\mid\\theta)$，数据已经固定，变化的是 $\\theta$。",
      "publishedAt": "2024-05-25",
      "readingTimeMinutes": 1,
      "sourceUrl": "https://example.com/bayes-lab/likelihood-function"
    },
    {
      "id": "a14",
      "title": "最大似然估计：让数据最可能的参数",
      "slug": "maximum-likelihood-estimation",
      "summary": "最大似然估计选择让观测数据出现概率最大的参数：$\\hat{\\theta}=\\arg\\max_\\theta L(\\theta)$。",
      "publishedAt": "2024-08-04",
      "readingTimeMinutes": 1,
      "sourceUrl": "https://example.com/bayes-lab/maximum-likelihood-estimation"
    },
    {
      "id": "a15",
      "title": "置信区间：估计的不确定性范围",
      "slug": "confidence-interval",
      "summary": "置信区间把点估计扩展成一个范围：$\\hat{\\theta}\\pm z_{1-\\alpha/2}\\cdot\\operatorname{SE}(\\hat{\\theta})$。",
      "publishedAt": "2024-10-19",
      "readingTimeMinutes": 1,
      "sourceUrl": "https://example.com/bayes-lab/confidence-interval"
    },
    {
      "id": "a16",
      "title": "假设检验：判断差异是否真实",
      "slug": "hypothesis-testing",
      "summary": "假设检验先设定原假设 $H_0$，再计算在 $H_0$ 成立时观测到当前数据（或更极端数据）的概率，也就是 p 值。",
      "publishedAt": "2024-12-08",
      "readingTimeMinutes": 1,
      "sourceUrl": "https://example.com/bayes-lab/hypothesis-testing"
    },
    {
      "id": "a17",
      "title": "贝叶斯推断：先验与后验的更新",
      "slug": "bayesian-inference",
      "summary": "贝叶斯推断把参数也看作随机变量，用先验 $p(\\theta)$ 表达初始判断，再用数据通过贝叶斯定理得到后验 $p(\\theta\\mid x)\\propto p(x\\mid\\theta)p(\\theta)$。",
      "publishedAt": "2025-01-18",
      "readingTimeMinutes": 1,
      "sourceUrl": "https://example.com/bayes-lab/bayesian-inference"
    }
  ],
