  "articles": [
    {
      "id": "a01",
      "title": "从语言模型到大语言模型：规模改变了什么",
      "slug": "from-lm-to-llm",
      "summary": "大语言模型通过更大规模的数据与计算学习语言分布，但规模本身并不能解释全部能力。",
      "publishedAt": "2022-03-18",
      "readingTimeMinutes": 1,
      "sourceUrl": "https://example.com/context-lab/from-lm-to-llm"
    },
    {
      "id": "a02",
      "title": "Transformer 为什么能取代循环网络",
      "slug": "why-transformer",
      "summary": "Transformer 用 Attention 在任意 token 之间建立直接连接，并让训练可以高度并行。",
      "publishedAt": "2022-05-07",
      "readingTimeMinutes": 1,
      "sourceUrl": "https://example.com/context-lab/why-transformer"
    },
    {
      "id": "a03",
      "title": "Attention：一次信息路由的完整推导",
      "slug": "attention-routing",
      "summary": "Attention 根据查询与键的匹配程度，对值进行动态加权聚合。",
      "publishedAt": "2022-06-21",
      "readingTimeMinutes": 1,
      "sourceUrl": "https://example.com/context-lab/attention-routing"
    },
    {
      "id": "a04",
      "title": "没有顺序的模型如何理解位置",
      "slug": "position-encoding",
      "summary": "Transformer 的 Attention 本身无法区分 token 的先后，因此需要位置编码补足顺序信息。",
      "publishedAt": "2022-08-11",
      "readingTimeMinutes": 1,
      "sourceUrl": "https://example.com/context-lab/position-encoding"
    },
    {
      "id": "a05",
      "title": "RoPE：把相对位置旋转进 Attention",
      "slug": "rope-explained",
      "summary": "RoPE 是位置编码的一种扩展：它对查询和键应用成对旋转，让 Attention 分数自然携带相对距离。",
      "publishedAt": "2022-10-02",
      "readingTimeMinutes": 1,
      "sourceUrl": "https://example.com/context-lab/rope-explained"
    },
    {
      "id": "a06",
      "title": "大模型生成为什么越来越慢",
      "slug": "autoregressive-bottleneck",
      "summary": "推理服务中的自回归解码必须逐 token 执行，生成阶段常常受显存带宽而非算力限制。",
      "publishedAt": "2023-01-15",
      "readingTimeMinutes": 1,
      "sourceUrl": "https://example.com/context-lab/autoregressive-bottleneck"
    },
    {
      "id": "a07",
      "title": "KV Cache：用显存换时间的推理账本",
      "slug": "kv-cache",
      "summary": "KV Cache 保存 Attention 已经计算过的 Key 与 Value，让下一步生成只处理新增 token。",
      "publishedAt": "2023-03-09",
      "readingTimeMinutes": 1,
      "sourceUrl": "https://example.com/context-lab/kv-cache"
    },
    {
      "id": "a08",
      "title": "FlashAttention 快在哪里",
      "slug": "flash-attention",
      "summary": "FlashAttention 优化的仍是精确 Attention，而不是近似注意力。",
      "publishedAt": "2023-05-26",
      "readingTimeMinutes": 1,
      "sourceUrl": "https://example.com/context-lab/flash-attention"
    },
    {
      "id": "a09",
      "title": "推理服务的三个核心指标",
      "slug": "serving-metrics",
      "summary": "推理服务需要同时观察吞吐、首 token 延迟和逐 token 延迟。",
      "publishedAt": "2023-07-04",
      "readingTimeMinutes": 1,
      "sourceUrl": "https://example.com/context-lab/serving-metrics"
    },
    {
      "id": "a10",
      "title": "Continuous Batching：让 GPU 不等人",
      "slug": "continuous-batching",
      "summary": "连续批处理允许推理服务在旧请求结束后立刻补入新请求，而不必等待整批完成。",
      "publishedAt": "2023-08-19",
      "readingTimeMinutes": 1,
      "sourceUrl": "https://example.com/context-lab/continuous-batching"
    },
    {
      "id": "a11",
      "title": "PagedAttention 与显存碎片",
      "slug": "paged-attention",
      "summary": "PagedAttention 借鉴虚拟内存分页，把连续增长的 KV Cache 拆成固定大小的块。",
      "publishedAt": "2023-10-12",
      "readingTimeMinutes": 1,
      "sourceUrl": "https://example.com/context-lab/paged-attention"
    },
    {
      "id": "a12",
      "title": "vLLM 架构导读：从请求到 Token",
      "slug": "vllm-architecture",
      "summary": "vLLM 是推理服务的一种工程实现，它把 Continuous Batching、KV Cache 与 PagedAttention 串成完整执行链。",
      "publishedAt": "2023-12-03",
      "readingTimeMinutes": 1,
      "sourceUrl": "https://example.com/context-lab/vllm-architecture"
    },
    {
      "id": "a13",
      "title": "长上下文不是把窗口数字变大",
      "slug": "long-context-is-more",
      "summary": "上下文窗口定义单次推理可接收与生成的 token 预算，是讨论长上下文的长度边界。",
      "publishedAt": "2024-02-17",
      "readingTimeMinutes": 1,
      "sourceUrl": "https://example.com/context-lab/long-context-is-more"
    },
    {
      "id": "a14",
      "title": "RoPE 外推：位置插值与频率缩放",
      "slug": "rope-scaling",
      "summary": "RoPE 作为位置编码方案，其频率分布决定模型如何感知距离。",
      "publishedAt": "2024-04-08",
      "readingTimeMinutes": 1,
      "sourceUrl": "https://example.com/context-lab/rope-scaling"
    },
    {
      "id": "a15",
      "title": "长上下文的 KV Cache 成本",
      "slug": "long-context-kv-cost",
      "summary": "长上下文会线性放大 KV Cache，让单卡可承载的并发请求减少。",
      "publishedAt": "2024-06-22",
      "readingTimeMinutes": 1,
      "sourceUrl": "https://example.com/context-lab/long-context-kv-cost"
    },
    {
      "id": "a16",
      "title": "量化如何改变推理系统的瓶颈",
      "slug": "quantization-serving",
      "summary": "量化用更低精度表示权重或激活，会直接改变推理服务的显存与带宽瓶颈。",
